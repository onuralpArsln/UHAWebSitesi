{% macro socialShare(article, pageUrl, config = {}) %}
{% if article and pageUrl %}
{% set showFacebook = config.showFacebook !== false %}
{% set showTwitter = config.showTwitter !== false %}
{% set showWhatsapp = config.showWhatsapp !== false %}

{% if showFacebook or showTwitter or showWhatsapp %}
<div class="social-share-widget" data-widget="social-share">
  <div class="social-share__label">Paylaş:</div>
  <div class="social-share__buttons">
    {% if showFacebook %}
    <a 
      href="https://www.facebook.com/sharer/sharer.php?u={{ pageUrl | urlencode }}" 
      target="_blank" 
      rel="noopener noreferrer"
      class="social-share__button social-share__button--facebook"
      title="Facebook'ta Paylaş"
      aria-label="Facebook'ta Paylaş"
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
        <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
      </svg>
      <span>Facebook</span>
    </a>
    {% endif %}
    
    {% if showTwitter %}
    <a 
      href="https://twitter.com/intent/tweet?url={{ pageUrl | urlencode }}&text={{ article.title | urlencode }}" 
      target="_blank" 
      rel="noopener noreferrer"
      class="social-share__button social-share__button--twitter"
      title="Twitter'da Paylaş"
      aria-label="Twitter'da Paylaş"
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
        <path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"/>
      </svg>
      <span>Twitter</span>
    </a>
    {% endif %}
    
    {% if showWhatsapp %}
    <a 
      href="https://wa.me/?text={{ article.title | urlencode }}%20{{ pageUrl | urlencode }}" 
      target="_blank" 
      rel="noopener noreferrer"
      class="social-share__button social-share__button--whatsapp"
      title="WhatsApp'ta Paylaş"
      aria-label="WhatsApp'ta Paylaş"
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
      </svg>
      <span>WhatsApp</span>
    </a>
    {% endif %}
  </div>
</div>
{% endif %}
{% endif %}
{% endmacro %}

