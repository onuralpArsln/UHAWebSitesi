{% import "widgets/hero-title.njk" as heroTitleWidget %}
{% import "widgets/carousel.njk" as carouselWidget %}
{% import "widgets/featured-news-grid.njk" as featuredNewsGridWidget %}
{% import "widgets/category-feed.njk" as categoryFeedWidget %}
{% import "widgets/three-column-category-feed.njk" as threeColCategoryFeedWidget %}
{% import "widgets/ad-placeholder.njk" as adPlaceholderWidget %}
{% import "widgets/flashNews.njk" as flashNewsWidget %}
{% import "widgets/four-article-band.njk" as fourArticleBandWidget %}
{% import "widgets/banner-gorsel.njk" as bannerGorselWidget %}

{# Widget Renderer Macro - Dynamically renders widgets based on type #}
{% macro render(widget) %}
  {% if widget.type == 'hero-title' %}
    {{ heroTitleWidget.heroTitle(widget.config.title) }}
  
  {% elif widget.type == 'carousel' %}
    <section class="hero-carousel">
      <div class="container">
        {% if widget.data.articles and widget.data.articles | length %}
        {{ carouselWidget.carousel(widget.config.id, widget.data.articles, widget.config) }}
        {% else %}
        <p>Şu anda öne çıkan haber bulunmuyor.</p>
        {% endif %}
      </div>
    </section>

  {% elif widget.type == 'ana-manset' %}
    <section class="main-headline-2 mb-3">
      <div class="container">
        {% if widget.data.articles and widget.data.articles | length %}
          {{ carouselWidget.carousel(widget.config.id or 'ana-manset', widget.data.articles, widget.config) }}
          <div class="ana-manset-count">
            Toplam {{ widget.data.articles | length }} haber
          </div>
        {% else %}
          <p>Şu anda ana manşet bulunmuyor.</p>
        {% endif %}
      </div>
    </section>
  
  {% elif widget.type == 'featured-news-grid' %}
    {{ featuredNewsGridWidget.featuredNewsGrid(widget.data.articles) }}
  
  {% elif widget.type == 'category-feed' %}
    {{ categoryFeedWidget.categoryFeed({
      name: widget.config.categoryName or widget.config.category,
      slug: widget.config.categorySlug or widget.config.slug,
      articles: widget.data.articles
    }) }}

  {% elif widget.type == 'three-column-category-feed' %}
    {{ threeColCategoryFeedWidget.threeColumnCategoryFeed({
      columns: widget.data.columns
    }, {
      showTitles: widget.config.showTitles
    }) }}
  
  {% elif widget.type == 'ad-placeholder' %}
    {{ adPlaceholderWidget.adPlaceholder(widget.config.slot, widget.config.label, widget.config.size) }}
  
  {% elif widget.type == 'flash-news' %}
    {{ flashNewsWidget.flashNews(widget.config.id, widget.data.articles, widget.config) }}
  
  {% elif widget.type == 'four-article-band' %}
    {{ fourArticleBandWidget.fourArticleBand(widget.data.articles, widget.config.title) }}
  
  {% elif widget.type == 'banner-gorsel' %}
    {{ bannerGorselWidget.bannerGorsel(widget.config.imageUrl, widget.config) }}
  
  {% endif %}
{% endmacro %}
