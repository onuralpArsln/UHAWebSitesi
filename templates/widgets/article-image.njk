{% macro articleImage(article, config = {}) %}
{% if article %}
  {% if article.images and article.images.length > 0 %}
  {% set skipFirst = config.skipFirst %}
  {% set hasSecondImage = article.images.length > 1 %}
  {% set shouldRenderImage = (not skipFirst) or (skipFirst and hasSecondImage) %}
  {% if shouldRenderImage %}
  {% set imageIndex = 1 if (skipFirst and hasSecondImage) else 0 %}
  {% set displayImage = article.images[imageIndex] %}
  {% set maxHeight = config.maxHeight %}
  <figure class="article-view__media" {% if maxHeight %}style="max-height: {{ maxHeight }}px; overflow: hidden; display: flex; align-items: center; justify-content: center;"{% endif %}>
    <img
      src="{{ displayImage.lowRes }}"
      alt="{{ displayImage.alt or article.title }}"
      data-high-res="{{ displayImage.highRes }}"
      loading="eager"
      {% if maxHeight %}style="max-height: {{ maxHeight }}px; width: 100%; height: auto; object-fit: contain; display: block;"{% endif %}
    >
  </figure>
  {% endif %}
  {% endif %}
  
  {% if article.videoUrl %}
  <div class="article-view__video">
    {% if article.videoUrl.startsWith('/uploads/') %}
    <video controls preload="metadata" style="width: 100%; height: auto; border-radius: 8px;">
      <source src="{{ article.videoUrl }}" type="video/mp4">
      Tarayıcınız video etiketini desteklemiyor.
    </video>
    {% else %}
    <iframe
      src="{{ article.videoUrl }}"
      title="{{ article.title }} video"
      loading="lazy"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
      allowfullscreen
    ></iframe>
    {% endif %}
  </div>
  {% endif %}
{% endif %}
{% endmacro %}

