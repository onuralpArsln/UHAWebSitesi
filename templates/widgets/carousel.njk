{% macro carousel(id, slides, config = {}) %}
<div class="carousel-widget" 
     data-widget="carousel" 
     data-carousel-id="{{ id }}"
     data-autoplay="{{ config.autoPlay | default(true) }}"
     data-delay="{{ config.autoPlayDelay | default(5000) }}">
  <div class="carousel-container">
    <div class="carousel-track">
      {% for slide in slides %}
      {% set image = slide.headlineImage or (slide.images and slide.images[0]) %}
      <div class="carousel-slide{% if loop.first %} active{% endif %}">
        <a href="{{ asset('haber/' ~ slide.slug) }}" class="slide-link">
          <div class="slide-image">
            {% if image %}
            <img
              src="{{ image.url }}"
              alt="{{ image.alt or slide.title }}"
              width="{{ image.width }}"
              height="{{ image.height }}"
              {% if not loop.first %}loading="lazy"{% else %}loading="eager"{% endif %}
            >
            {% endif %}
          </div>
          <div class="slide-content">
            <h3>{{ slide.title }}</h3>
            <p>{{ slide.summary }}</p>
            <div class="slide-meta">
              <span class="category">{{ slide.category }}</span>
              <span class="date">{{ slide.publishedAt | formatDate }}</span>
            </div>
          </div>
        </a>
      </div>
      {% endfor %}
    </div>

    <div class="carousel-controls">
      <button class="carousel-prev" aria-label="Önceki haber">‹</button>
      <button class="carousel-next" aria-label="Sonraki haber">›</button>
    </div>

    <div class="carousel-indicators">
      {% for slide in slides %}
      <button
        class="indicator{% if loop.first %} active{% endif %}"
        data-slide="{{ loop.index0 }}"
        aria-label="Haber {{ loop.index }}"
      ></button>
      {% endfor %}
    </div>
  </div>
</div>
{% endmacro %}
