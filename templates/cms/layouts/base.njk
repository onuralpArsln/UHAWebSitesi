<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ pageTitle or 'BGrup Yazılım CMS' }}</title>
  {% set cmsBrand = branding or (initialState and initialState.branding) or {} %}
  {% if cmsBrand.favicon %}
  <link rel="icon" href="{{ cmsBrand.favicon }}" type="image/x-icon">
  {% endif %}
  <link rel="stylesheet" href="{{ asset('css/variables.css') }}">
  <link rel="stylesheet" href="{{ asset('css/main.css') }}">
  <link rel="stylesheet" href="{{ asset('cms/css/cms.css') }}?v=3">
  {% block head %}{% endblock %}
</head>
<body class="cms-body">
  <div class="cms-app">
    {% block body %}{% endblock %}
  </div>
  <script>
    window.__CMS_INITIAL_STATE__ = {{ initialStateJson | default('{}') | safe }};
  </script>
  <script src="{{ asset('cms/js/cms-app.js') }}?v=3" defer></script>
  {% block scripts %}{% endblock %}
</body>
</html>

