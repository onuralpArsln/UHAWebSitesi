{% macro HeadlineLayout(carouselArticles = [], carouselLimit = 5) %}
<section id="headline-layout" class="cms-section" data-cms="headline-layout-section" hidden>
  <div class="cms-section-heading">
    <div>
      <h2 class="cms-section__title">Manşet Düzeni</h2>
      <p class="cms-section__description">
        Manşet slider'ında görüntülenen haberleri yönetin. Sürükleyip bırakarak sıralamayı değiştirebilirsiniz.
        <span class="cms-badge badge--info">Limit: <span data-cms="carousel-count">{{ carouselArticles.length }}</span> / {{ carouselLimit }}</span>
      </p>
    </div>
    <button class="cms-btn cms-btn--primary" data-action="add-carousel-article">
      <i class="icon-plus"></i> Haber Ekle
    </button>
  </div>

  <div class="cms-table-wrapper">
    <table class="cms-table" data-cms="headline-layout-table">
      <thead>
        <tr>
          <th width="50"></th>
          <th width="60">Sıra</th>
          <th>Haber</th>
          <th>Kategori</th>
          <th>Tarih</th>
          <th width="100">İşlemler</th>
        </tr>
      </thead>
      <tbody>
        {% for article in carouselArticles %}
        <tr draggable="true" data-article-id="{{ article.id }}" data-index="{{ loop.index0 }}">
          <td class="drag-handle-cell"><span class="drag-handle">☰</span></td>
          <td class="layout-order">{{ loop.index }}</td>
          <td>
            <div class="article-title-cell">
              {% if article.images and article.images[0] %}
              <img src="{{ article.images[0].url }}" alt="{{ article.header or article.title }}" class="article-thumb">
              {% endif %}
              <div class="article-info">
                <span class="article-title">{{ article.header or article.title }}</span>
                <span class="article-status {{ article.status }}">{{ article.status == 'published' ? 'Yayında' : 'Taslak' }}</span>
              </div>
            </div>
          </td>
          <td><span class="cms-badge">{{ article.category or 'Genel' }}</span></td>
          <td>{{ article.creationDate or article.publishedAt | date('DD.MM.YYYY') }}</td>
          <td>
            <button class="cms-btn-icon danger" data-action="remove-carousel-article" title="Kaldır">
              <i class="icon-trash"></i>
            </button>
          </td>
        </tr>
        {% else %}
        <tr class="empty-state">
          <td colspan="6">
            <div class="cms-empty-state">
              <p>Henüz manşet slider'ına eklenmiş haber bulunmuyor.</p>
              <button class="cms-btn cms-btn--text" data-action="add-carousel-article">Haber Ekle</button>
            </div>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  <div class="cms-actions-footer">
    <button class="cms-btn cms-btn--primary" data-action="save-carousel-layout">
      <i class="icon-save"></i> Değişiklikleri Kaydet
    </button>
  </div>
</section>

<!-- Add Article Modal -->
<div class="cms-modal" id="add-carousel-article-modal" hidden>
  <div class="cms-modal__overlay" data-action="close-modal"></div>
  <div class="cms-modal__content">
    <div class="cms-modal__header">
      <h3>Manşete Haber Ekle</h3>
      <button class="cms-modal__close" data-action="close-modal">&times;</button>
    </div>
    <div class="cms-modal__body">
      <div class="cms-search-bar">
        <input type="text" class="cms-input" placeholder="Haber başlığı ile ara..." data-action="search-carousel-articles">
      </div>
      <div class="article-selection-list" data-cms="article-selection-list">
        <div class="loading-spinner" hidden>Yükleniyor...</div>
        <!-- Articles will be injected here via JS -->
      </div>
    </div>
  </div>
</div>

<style>
.drag-handle-cell {
  cursor: grab;
  color: #a0aec0;
  text-align: center;
}
.drag-handle {
  font-size: 1.2em;
}
.article-title-cell {
  display: flex;
  align-items: center;
  gap: 12px;
}
.article-thumb {
  width: 60px;
  height: 40px;
  object-fit: cover;
  border-radius: 4px;
  flex-shrink: 0;
  background: #edf2f7;
}
.article-info {
  display: flex;
  flex-direction: column;
  gap: 2px;
}
.article-title {
  font-weight: 500;
  color: #2d3748;
}
.article-status {
  font-size: 0.75em;
  color: #718096;
}
.article-status.published {
  color: #38a169;
}
.article-selection-list {
  max-height: 400px;
  overflow-y: auto;
  margin-top: 1rem;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}
.article-selection-item {
  display: flex;
  align-items: center;
  gap: 1rem;
  padding: 0.75rem;
  border: 1px solid #e2e8f0;
  border-radius: 0.375rem;
  cursor: pointer;
  transition: all 0.2s;
}
.article-selection-item:hover {
  background: #f7fafc;
  border-color: #cbd5e0;
}
.article-selection-item.disabled {
  opacity: 0.6;
  cursor: not-allowed;
  background: #f7fafc;
}
.article-selection-item img {
  width: 50px;
  height: 50px;
  object-fit: cover;
  border-radius: 4px;
}
.article-selection-info {
  flex: 1;
}
.article-selection-title {
  font-weight: 500;
  display: block;
}
.article-selection-meta {
  font-size: 0.8em;
  color: #718096;
}
.cms-actions-footer {
  margin-top: 2rem;
  padding-top: 1rem;
  border-top: 1px solid #e2e8f0;
  display: flex;
  justify-content: flex-end;
}
</style>
{% endmacro %}
