{% macro Sidebar(active = 'dashboard', cmsTabs = []) %}
<nav class="cms-sidebar" data-cms="sidebar">
  <div class="cms-logo">BGrup Yazılım CMS</div>
  <ul class="cms-nav">
    {% for tab in cmsTabs %}
    <li>
      <a href="#{{ tab.id }}" class="nav-link{% if active == tab.id %} active{% endif %}">
        {{ tab.label }}
      </a>
    </li>
    {% endfor %}
  </ul>
  <div class="cms-sidebar-footer">
    <button class="cms-btn cms-btn-secondary cms-btn--logout" data-action="logout">
      <span>Çıkış Yap</span>
    </button>
  </div>
</nav>
{% endmacro %}

