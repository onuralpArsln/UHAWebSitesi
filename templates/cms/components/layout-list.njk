{% macro LayoutList(layout = [], targetOptions = []) %}
<section id="layout" class="cms-section" data-cms="layout-section" hidden>
  <div class="cms-section-heading">
    <div>
      <h2 class="cms-section__title">Sayfa Düzeni</h2>
      <p class="cms-section__description">Ana sayfa bileşenlerinin sıralaması ve yapılandırması. Sıralamayı değiştirmek için sürükleyip bırakın.</p>
    </div>
    <div class="cms-section-actions">
      <button class="cms-btn cms-btn-secondary" data-action="add-widget">Bileşen Ekle</button>
      <button class="cms-btn cms-btn-primary" data-action="save-layout">Değişiklikleri Kaydet</button>
    </div>
  </div>

  <div class="cms-card">
    <div class="cms-table-container">
      <table class="cms-table" data-cms="layout-table">
        <thead>
          <tr>
            <th width="40"></th>
            <th width="50">Sıra</th>
            <th>Bileşen Tipi</th>
            <th>Yapılandırma</th>
            <th>Durum</th>
          </tr>
        </thead>
        <tbody>
          {% if layout and layout.length %}
            {% for widget in layout %}
            <tr data-index="{{ loop.index0 }}">
              <td class="layout-drag-handle" title="Sürükle">
                <span class="drag-icon">⋮⋮</span>
              </td>
              <td class="layout-order">{{ loop.index }}</td>
              <td>
                {% set widgetTitles = {
                  'hero-title': 'Manşet Başlığı',
                  'carousel': 'Manşet Slider',
                  'ana-manset': 'Ana Manşet Slider',
                  'featured-news-grid': 'Öne Çıkanlar Izgarası',
                  'four-article-band': '4\'lü Haber Bandı',
                  'category-feed': 'Kategori Akışı',
                  'three-column-category-feed': '3 Kolon Kategori Akışı',
                  'flash-news': 'Son Dakika Bandı',
                  'ad-placeholder': 'Reklam Alanı',
                  'banner-gorsel': 'Banner Görsel'
                } %}
                <span class="cms-badge cms-badge--primary">{{ widgetTitles[widget.type] or widget.type }}</span>
              </td>
              <td>
                <div class="widget-config-controls">
                  {% if widget.type == 'carousel' %}
                    <label class="config-control">
                      <input type="checkbox" 
                             data-config="autoplay" 
                             data-widget-index="{{ loop.index0 }}"
                             {% if widget.config.autoplay %}checked{% endif %}>
                      Otomatik oynat
                    </label>
                    <label class="config-control">
                      <span>Süre:</span>
                      <input type="number" 
                             data-config="interval" 
                             data-widget-index="{{ loop.index0 }}"
                             value="{{ (widget.config.interval / 1000) or 5 }}" 
                             min="1" 
                             max="30"
                             class="config-input-small"> saniye
                    </label>
                    <label class="config-control">
                      <span>Mobil yükseklik:</span>
                      <input type="number" 
                             data-config="heightMobile" 
                             data-widget-index="{{ loop.index0 }}"
                             value="{{ widget.config.heightMobile or 400 }}" 
                             min="200" 
                             max="800"
                             class="config-input-small"> px
                    </label>
                    <label class="config-control">
                      <span>Tablet yükseklik:</span>
                      <input type="number" 
                             data-config="heightTablet" 
                             data-widget-index="{{ loop.index0 }}"
                             value="{{ widget.config.heightTablet or 500 }}" 
                             min="200" 
                             max="800"
                             class="config-input-small"> px
                    </label>
                    <label class="config-control">
                      <span>Masaüstü yükseklik:</span>
                      <input type="number" 
                             data-config="heightDesktop" 
                             data-widget-index="{{ loop.index0 }}"
                             value="{{ widget.config.heightDesktop or 600 }}" 
                             min="200" 
                             max="800"
                             class="config-input-small"> px
                    </label>
                  
                  {% elif widget.type == 'ana-manset' %}
                    <label class="config-control">
                      <span>Mobil yükseklik:</span>
                      <input type="number" 
                             data-config="heightMobile" 
                             data-widget-index="{{ loop.index0 }}"
                             value="{{ widget.config.heightMobile or 400 }}" 
                             min="200" 
                             max="800"
                             class="config-input-small"> px
                    </label>
                    <label class="config-control">
                      <span>Tablet yükseklik:</span>
                      <input type="number" 
                             data-config="heightTablet" 
                             data-widget-index="{{ loop.index0 }}"
                             value="{{ widget.config.heightTablet or 500 }}" 
                             min="200" 
                             max="800"
                             class="config-input-small"> px
                    </label>
                    <label class="config-control">
                      <span>Masaüstü yükseklik:</span>
                      <input type="number" 
                             data-config="heightDesktop" 
                             data-widget-index="{{ loop.index0 }}"
                             value="{{ widget.config.heightDesktop or 600 }}" 
                             min="200" 
                             max="800"
                             class="config-input-small"> px
                    </label>
                  
                  {% elif widget.type == 'hero-title' %}
                    <label class="config-control">
                      <span>Başlık:</span>
                      <input type="text" 
                             data-config="title" 
                             data-widget-index="{{ loop.index0 }}"
                             value="{{ widget.config.title or '' }}" 
                             placeholder="Başlık girin"
                             class="config-input">
                    </label>
                  
                  {% elif widget.type == 'featured-news-grid' %}
                    <label class="config-control">
                      <span>Haber sayısı:</span>
                      <input type="number" 
                             data-config="limit" 
                             data-widget-index="{{ loop.index0 }}"
                             value="{{ widget.config.limit or 6 }}" 
                             min="1" 
                             max="20"
                             class="config-input-small">
                    </label>
                  
                  {% elif widget.type == 'four-article-band' %}
                    <label class="config-control">
                      <span>Başlık:</span>
                      <input type="text" 
                             data-config="title" 
                             data-widget-index="{{ loop.index0 }}"
                             value="{{ widget.config.title or '' }}" 
                             placeholder="Bant başlığı"
                             class="config-input">
                    </label>
                    <label class="config-control">
                      <span>Hedef etiketi:</span>
                      {% if targetOptions and targetOptions | length %}
                        <select data-config="target" 
                                data-widget-index="{{ loop.index0 }}"
                                class="config-select">
                          <option value="">Hedef seçin</option>
                          {% for target in targetOptions %}
                            <option value="{{ target.value }}"
                                    {% if target.value == widget.config.target %}selected{% endif %}>
                              {{ target.label }}
                            </option>
                          {% endfor %}
                        </select>
                      {% else %}
                        <input type="text" 
                               data-config="target" 
                               data-widget-index="{{ loop.index0 }}"
                               value="{{ widget.config.target or '' }}" 
                               placeholder="Örn. spotlight-hero"
                               class="config-input">
                      {% endif %}
                    </label>
                    <label class="config-control">
                      <span>Haber sayısı:</span>
                      <input type="number" 
                             data-config="limit" 
                             data-widget-index="{{ loop.index0 }}"
                             value="{{ widget.config.limit or 4 }}" 
                             min="1" 
                             max="8"
                             class="config-input-small">
                    </label>
                  
                  {% elif widget.type == 'category-feed' %}
                    <label class="config-control">
                      <span>Kategori:</span>
                      <select data-config="categorySlug" 
                              data-widget-index="{{ loop.index0 }}"
                              class="config-select">
                        {% if initialState.categories.length > 0 %}
                          {% for cat in initialState.categories %}
                            {# Check both categorySlug (new) and slug (old) for compatibility #}
                            {% set currentSlug = widget.config.categorySlug or widget.config.slug %}
                            <option value="{{ cat.slug }}" 
                                    {% if cat.slug == currentSlug %}selected{% endif %}>
                              {{ cat.name }}
                            </option>
                          {% endfor %}
                        {% else %}
                          <option value="">Kategori bulunamadı</option>
                        {% endif %}
                      </select>
                    </label>
                    <label class="config-control">
                      <span>Haber sayısı:</span>
                      <input type="number" 
                             data-config="limit" 
                             data-widget-index="{{ loop.index0 }}"
                             value="{{ widget.config.limit or 5 }}" 
                             min="1" 
                             max="20"
                             class="config-input-small">
                    </label>

                  {% elif widget.type == 'three-column-category-feed' %}
                    <label class="config-control">
                      <span>Kolon 1 Kategori:</span>
                      <select data-config="categorySlug1"
                              data-widget-index="{{ loop.index0 }}"
                              class="config-select">
                        {% if initialState.categories.length > 0 %}
                          {% for cat in initialState.categories %}
                            {% set currentSlug = widget.config.categorySlug1 %}
                            <option value="{{ cat.slug }}"
                                    {% if cat.slug == currentSlug %}selected{% endif %}>
                              {{ cat.name }}
                            </option>
                          {% endfor %}
                        {% else %}
                          <option value="">Kategori bulunamadı</option>
                        {% endif %}
                      </select>
                    </label>

                    <label class="config-control">
                      <span>Kolon 2 Kategori:</span>
                      <select data-config="categorySlug2"
                              data-widget-index="{{ loop.index0 }}"
                              class="config-select">
                        {% if initialState.categories.length > 0 %}
                          {% for cat in initialState.categories %}
                            {% set currentSlug = widget.config.categorySlug2 %}
                            <option value="{{ cat.slug }}"
                                    {% if cat.slug == currentSlug %}selected{% endif %}>
                              {{ cat.name }}
                            </option>
                          {% endfor %}
                        {% else %}
                          <option value="">Kategori bulunamadı</option>
                        {% endif %}
                      </select>
                    </label>

                    <label class="config-control">
                      <span>Kolon 3 Kategori:</span>
                      <select data-config="categorySlug3"
                              data-widget-index="{{ loop.index0 }}"
                              class="config-select">
                        {% if initialState.categories.length > 0 %}
                          {% for cat in initialState.categories %}
                            {% set currentSlug = widget.config.categorySlug3 %}
                            <option value="{{ cat.slug }}"
                                    {% if cat.slug == currentSlug %}selected{% endif %}>
                              {{ cat.name }}
                            </option>
                          {% endfor %}
                        {% else %}
                          <option value="">Kategori bulunamadı</option>
                        {% endif %}
                      </select>
                    </label>

                    <label class="config-control">
                      <input type="checkbox"
                             data-config="showTitles"
                             data-widget-index="{{ loop.index0 }}"
                             {% if widget.config.showTitles is not defined or widget.config.showTitles %}checked{% endif %}>
                      Başlıkları göster (kategori + Tümünü Gör)
                    </label>
                  
                  {% elif widget.type == 'flash-news' %}
                    <label class="config-control">
                      <span>Haber sayısı:</span>
                      <input type="number" 
                             data-config="limit" 
                             data-widget-index="{{ loop.index0 }}"
                             value="{{ widget.config.limit or 10 }}" 
                             min="1" 
                             max="30"
                             class="config-input-small">
                    </label>
                  
                  {% elif widget.type == 'ad-placeholder' %}
                    <label class="config-control">
                      <span>Boyut:</span>
                      <select data-config="size" 
                              data-widget-index="{{ loop.index0 }}"
                              class="config-select">
                        <option value="standard" {% if widget.config.size == 'standard' %}selected{% endif %}>Standart</option>
                        <option value="large" {% if widget.config.size == 'large' %}selected{% endif %}>Büyük</option>
                        <option value="banner" {% if widget.config.size == 'banner' %}selected{% endif %}>Banner</option>
                      </select>
                    </label>
                  
                  {% elif widget.type == 'banner-gorsel' %}
                    <div class="config-control">
                      <label>
                        <span>Görsel:</span>
                        <button type="button" 
                                class="cms-btn cms-btn-secondary config-btn-small"
                                data-action="banner-gorsel-select-media"
                                data-widget-index="{{ loop.index0 }}">
                          {% if widget.config.imageUrl %}Görseli Değiştir{% else %}Görsel Seç{% endif %}
                        </button>
                      </label>
                      {% if widget.config.imageUrl %}
                      <div class="banner-gorsel-preview" data-banner-gorsel-preview="{{ loop.index0 }}">
                        <img src="{{ widget.config.imageUrl }}" alt="Önizleme" style="max-width: 100px; max-height: 60px; object-fit: contain;">
                        <button type="button" 
                                class="btn-icon btn-delete btn-icon-small"
                                data-action="banner-gorsel-remove"
                                data-widget-index="{{ loop.index0 }}"
                                title="Görseli Kaldır">×</button>
                      </div>
                      {% endif %}
                    </div>
                    <label class="config-control">
                      <span>Alt metin:</span>
                      <input type="text" 
                             data-config="alt" 
                             data-widget-index="{{ loop.index0 }}"
                             value="{{ widget.config.alt or '' }}" 
                             placeholder="Görsel açıklaması"
                             class="config-input">
                    </label>
                    <label class="config-control">
                      <span>Maksimum genişlik:</span>
                      <input type="number" 
                             data-config="maxWidth" 
                             data-widget-index="{{ loop.index0 }}"
                             value="{{ widget.config.maxWidth or 1280 }}" 
                             min="100" 
                             max="2000"
                             class="config-input-small"> px
                    </label>
                    <label class="config-control">
                      <span>Maksimum yükseklik:</span>
                      <input type="number" 
                             data-config="maxHeight" 
                             data-widget-index="{{ loop.index0 }}"
                             value="{{ widget.config.maxHeight or 600 }}" 
                             min="100" 
                             max="2000"
                             class="config-input-small"> px
                    </label>
                  
                  {% else %}
                    <span class="config-text">Özel yapılandırma</span>
                  {% endif %}
                </div>
              </td>
              <td>
                <div class="status-actions">
                  <span class="cms-status {% if widget.config.hidden %}is-passive{% endif %}" 
                        data-action="toggle-status" 
                        data-widget-index="{{ loop.index0 }}"
                        title="Durumu değiştirmek için tıklayın">
                    {{ 'Pasif' if widget.config.hidden else 'Aktif' }}
                  </span>
                  <button type="button" class="btn-icon btn-delete" data-action="remove-widget" data-widget-index="{{ loop.index0 }}" title="Bileşeni Kaldır">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="3 6 5 6 21 6"></polyline>
                      <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                      <line x1="10" y1="11" x2="10" y2="17"></line>
                      <line x1="14" y1="11" x2="14" y2="17"></line>
                    </svg>
                  </button>
                </div>
              </td>
            </tr>
            {% endfor %}
          {% else %}
            <tr>
              <td colspan="5" class="cms-empty-state">Bileşen bulunamadı.</td>
            </tr>
          {% endif %}
        </tbody>
      </table>
    </div>
  </div>
  <div class="cms-modal-overlay" data-modal="add-widget">
    <div class="cms-modal">
      <div class="cms-modal__header">
        <h3 class="cms-modal__title">Bileşen Ekle</h3>
        <button class="cms-modal__close" data-action="close-modal">×</button>
      </div>
      <div class="cms-modal__body">
        <div class="widget-list" data-cms="widget-list">
          <!-- Widgets will be populated here by JS -->
        </div>
      </div>
    </div>
  </div>
</section>
{% endmacro %}
